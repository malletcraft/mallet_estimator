<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- READING the gallery. Writing our own images into Pictures/ needs no
         permission and never did — which is what the note here used to say,
         and it was true and beside the point.

         Finding an ANNOTATED COPY is the opposite case: that file belongs to
         ImageMeter, and from Android 13 a query against MediaStore without
         READ_MEDIA_IMAGES returns ONLY the app's own media. So the scan that
         looks for the app's stamp in the gallery was searching a set that
         could not contain the answer — every foreign image invisible, our own
         ones skipped by design as "not an annotation of itself". It reported
         "found nothing" perfectly correctly, and could never have reported
         anything else.

         Amit, 2026-08-22: "you have ids local gallery access . if human can
         see it, so you must." Quite right — and it did not have that access.
         READ_EXTERNAL_STORAGE covers Android 12 and below, where the newer
         permission does not exist. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Self-update: the app hands its own next APK to the system
         installer. Android still requires the person to tap Install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The Leica DISTO over Bluetooth LE. neverForLocation is honest and it
         matters: we scan for one laser meter by its service UUID and have no
         interest in where anybody is, so on Android 12+ this asks for no
         location permission at all. The legacy entries below exist only for
         Android 11 and older, where a BLE scan was impossible without them. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- Voice notes: on site there is often no free hand for typing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- tools:replace: the Insta360 SDK's library manifest ships its own
         android:label; ours wins, by declaration rather than by luck. -->
    <application
        android:name=".SitePhotosApp"
        android:label="MCFT Site Photos"
        tools:replace="android:label"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.malletcrafts.sitephotos.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
