<?xml version="1.0" encoding="utf-8"?>
<!-- Self-update: the app hands its own next APK to the system installer
     (Android still requires the person to tap Install). The permission
     lives in its own module so the Play bundle can simply not include it:
     Google Play refuses ordinary apps that carry REQUEST_INSTALL_PACKAGES,
     and forbids self-updating outside Play besides. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
