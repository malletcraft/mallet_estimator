   "fieldtype": "Data",
   "label": "Device Capture ID",
   "no_copy": 1,
   "read_only": 1,
   "unique": 1
  },
  {
   "description": "App versionName the phone reported when this capture synced - the fleet's version ledger, one row per capture.",
   "fieldname": "device_app_version",
   "fieldtype": "Data",
   "hidden": 1,
   "label": "Device App Version",
   "read_only": 1
  },
  {
   "description": "Per-face annotation JSON from the app: {face: {lines: [{x1,y1,x2,y2,mm}], pins: [{x,y,text}]}}. Coordinates normalized 0..1; rendering happens at view time, originals stay pristine.",
