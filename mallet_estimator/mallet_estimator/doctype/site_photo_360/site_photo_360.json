   "label": "Capture Date",
   "reqd": 1
  },
  {
   "fieldname": "capture_kind",
   "fieldtype": "Select",
   "label": "Capture Kind",
   "options": "360\nPhoto",
   "default": "360",
   "in_list_view": 0,
   "description": "A 360 splits into six faces. A Photo is one flat image -- what a repair job usually needs -- and has none."
  },
  {
   "fieldname": "stage",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Phase",
   "options": "\nSurvey\nCivil\nFirst fix\nCeiling\nSurfaces\nDelivery\nJoinery\nSecond fix\nFinishing\nClosing",
   "description": "The coarse phase, used as the filter. The fine-grained stage is in Work Stage beside it."
  },
  {
   "description": "The one capture whose annotations the SketchUp model is built from. Only one per project + room.",
